{
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "--python",
              ">=3.11",
              "${CLAUDE_PLUGIN_ROOT}/scripts/webgate.py"
            ],
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "ERLA: checking the call for restricted terms and protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "--python",
              ">=3.11",
              "${CLAUDE_PLUGIN_ROOT}/scripts/webscan.py"
            ],
            "timeout": 15,
            "statusMessage": "ERLA: scanning the web result for injected instructions"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "erla:.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "--python",
              ">=3.11",
              "${CLAUDE_PLUGIN_ROOT}/scripts/subagent_log.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "--python",
              ">=3.11",
              "${CLAUDE_PLUGIN_ROOT}/scripts/answergate.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "erla:.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "--python",
              ">=3.11",
              "${CLAUDE_PLUGIN_ROOT}/scripts/subagent_log.py"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "--python",
              ">=3.11",
              "${CLAUDE_PLUGIN_ROOT}/scripts/answergate.py"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
